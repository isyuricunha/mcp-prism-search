---
const sections = [
  ["overview", "Overview"], ["providers", "Providers"], ["playground", "Playground"],
  ["cache", "Cache"], ["settings", "Settings"], ["connection", "Connection"]
];
---
<!doctype html>
<html lang="en" data-theme="yu-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content="Prism Search administration" />
    <title>Prism Search · Dashboard</title>
    <link rel="stylesheet" href="/theme.css" />
    <link rel="stylesheet" href="/app.css" />
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    <div id="login" class="login-shell" hidden>
      <form id="login-form" class="card login-card">
        <div class="brand"><span class="mark" aria-hidden="true">◇</span> Prism Search</div>
        <h1>Welcome back.</h1>
        <p class="muted">Sign in to manage your search server.</p>
        <label for="password">Administrator password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" />
        <button class="primary" type="submit">Sign in</button>
        <p id="login-status" class="status" role="alert"></p>
      </form>
    </div>
    <div id="dashboard" class="shell" hidden>
      <aside class="sidebar">
        <div class="brand"><span class="mark" aria-hidden="true">◇</span><div>Prism Search<small>Administration</small></div></div>
        <nav aria-label="Dashboard">
          {sections.map(([id, name]) => <button type="button" data-page={id} class="nav-button">{name}</button>)}
        </nav>
        <div class="sidebar-footer">
          <button id="theme" type="button">Switch to White</button>
          <button id="logout" type="button">Sign out</button>
        </div>
      </aside>
      <main>
        <header class="top"><div><span class="eyebrow">WORKSPACE / ADMIN</span><h1 id="page-title">Overview</h1></div><button id="refresh" type="button">Refresh</button></header>
        <p id="status" class="status" role="status" aria-live="polite"></p>
        <section id="overview" class="page">
          <p class="muted">Search engine availability and provider request activity.</p>
          <div id="summary" class="summary"></div>
          <div class="card"><div class="heading"><div><h2>Provider activity</h2><p class="muted">Lifetime upstream requests while the dashboard is enabled. Metrics contain no query text; search caching is separate.</p></div></div>
            <div class="table-wrap"><table><thead><tr><th>Provider</th><th>Requests</th><th>Success</th><th>Empty</th><th>Errors</th><th>429</th><th>Avg. latency</th></tr></thead><tbody id="metrics"></tbody></table></div>
          </div>
        </section>
        <section id="providers" class="page" hidden>
          <p class="muted">Enable engines and replace API keys. Changes apply immediately to new aggregated searches. Environment credentials are read-only.</p>
          <div id="provider-list" class="provider-list"></div>
        </section>
        <section id="playground" class="page" hidden>
          <form id="search-form" class="card">
            <h2>Search playground</h2><p class="muted">Choose the engines to query. Configured authenticated engines may consume credits.</p>
            <label for="query">Search query</label><textarea id="query" required maxlength="1000" rows="3" placeholder="What would you like to find?"></textarea>
            <fieldset><legend>Providers</legend><div id="choices" class="choices"></div></fieldset>
            <button type="submit" class="primary">Run search</button>
          </form>
          <p id="search-attempts" class="muted" aria-live="polite"></p><div id="results"></div>
        </section>
        <section id="cache" class="page" hidden>
          <div class="card"><h2>Cache status</h2><p class="muted">Inspect and remove expired or corrupt cache entries. Active entries are preserved.</p><pre id="cache-stats"></pre><div class="provider-actions"><button id="prune" type="button">Prune expired entries</button><button id="clear-cache" type="button">Clear cache</button></div></div>
        </section>
        <section id="settings" class="page" hidden>
          <form id="settings-form" class="card">
            <h2>Search settings</h2><p class="muted">Environment variables override dashboard settings. Changes apply to subsequent searches. Health still takes precedence over your preferred engine.</p>
            <label for="timeout">Provider timeout (seconds)</label><input id="timeout" type="number" min="2" max="120" required />
            <label for="search_ttl">Search cache TTL (seconds)</label><input id="search_ttl" type="number" min="60" max="604800" required />
            <label for="fetch_ttl">Fetch cache TTL (seconds)</label><input id="fetch_ttl" type="number" min="60" max="604800" required />
            <label for="preferred">Preferred engine</label><select id="preferred"></select>
            <button class="primary" type="submit">Save settings</button>
          </form>
        </section>
        <section id="connection" class="page" hidden>
          <div class="card"><h2>MCP connection</h2><p class="muted">The dashboard password is separate from the MCP bearer token. Connect using the MCP endpoint configured on your server, not this dashboard port.</p><label for="endpoint">MCP endpoint</label><input id="endpoint" type="url" value="http://127.0.0.1:49317/mcp" /><pre id="connection-json"></pre><p class="muted">Replace the token placeholder privately. The dashboard never reads or displays your MCP bearer token.</p></div>
        </section>
      </main>
    </div>
    <noscript><p class="card">Enable JavaScript to use the local administration interface.</p></noscript>
  </body>
</html>
