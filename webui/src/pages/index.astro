---
const sections = [
  ["overview", "Overview", "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z"],
  ["providers", "Providers", "M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18 M3 12h18 M12 3c4 4 4 14 0 18 M12 3c-4 4-4 14 0 18"],
  ["playground", "Playground", "M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 1 0 0-15 M16 16l5 5"],
  ["cache", "Cache", "M4 6c0-2 16-2 16 0v12c0 2-16 2-16 0z M4 6c0 2 16 2 16 0 M4 12c0 2 16 2 16 0"],
  ["logs", "Logs", "M5 3h14v18H5z M8 7h8 M8 12h8 M8 17h5"],
  ["settings", "Settings", "M4 6h16 M4 12h16 M4 18h16 M8 3v6 M16 9v6 M10 15v6"],
  ["connection", "Connection", "M10 7l3-3a4 4 0 0 1 6 6l-3 3 M14 17l-3 3a4 4 0 0 1-6-6l3-3 M9 15l6-6"]
];
---
<!doctype html>
<html lang="en" data-theme="yu-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content="Manage Prism Search providers, searches, cache and MCP connections." />
    <title>Prism Search · Administration</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/theme.css" />
    <link rel="stylesheet" href="/app.css" />
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    <div id="background-layer" aria-hidden="true"></div>
    <div id="boot" class="login-shell"><div class="card login-card" role="status"><h1>Prism Search</h1><p id="boot-message" class="muted">Connecting to your server…</p><button id="boot-retry" hidden>Retry connection</button></div></div>
    <div id="login" class="login-shell" hidden>
      <form id="login-form" class="card login-card" novalidate>
        <div class="brand"><img src="/favicon.svg" width="36" height="36" alt="" /> Prism Search</div>
        <div class="stack"><span class="eyebrow">Private administration</span><h1>Sign in</h1><p class="muted">Manage your self-hosted search server. Use the password set in MCP_WEBUI_PASSWORD, not your MCP token.</p></div>
        <div class="field"><label for="password">Administrator password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" aria-describedby="login-status" /><button id="password-visibility" type="button" aria-pressed="false">Show</button></div></div>
        <p id="login-status" class="feedback" role="alert"></p>
        <button class="primary" type="submit">Sign in</button>
        <div class="login-footer"><a href="https://github.com/isyuricunha/mcp-prism-search" target="_blank" rel="noopener noreferrer">Project documentation ↗</a><button type="button" id="login-theme">Switch to White</button></div>
      </form>
    </div>
    <div id="dashboard" class="shell" hidden>
      <a class="skip-link" href="#main">Skip to content</a>
      <aside class="sidebar">
        <div class="brand"><img src="/favicon.svg" width="36" height="36" alt="" /><div>Prism Search<small>Search workspace</small></div></div>
        <nav aria-label="Dashboard">
          <span class="nav-label">Workspace</span>
          {sections.map(([id, name, path]) => <button type="button" data-page={id} class="nav-button"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={path}/></svg><span>{name}</span></button>)}
        </nav>
        <div class="sidebar-footer">
          <div class="version-block"><span class="eyebrow">Installed server</span><a id="sidebar-version" href="https://github.com/isyuricunha/mcp-prism-search/releases" target="_blank" rel="noopener noreferrer">Version unavailable</a><span id="sidebar-build" class="muted" hidden></span><span id="sidebar-sdk" class="muted"></span></div>
          <a class="sidebar-link" href="https://github.com/isyuricunha/mcp-prism-search" target="_blank" rel="noopener noreferrer">Documentation ↗</a>
          <button id="theme" type="button">Switch to White</button>
          <button id="logout" type="button">Sign out</button>
        </div>
      </aside>
      <main id="main" tabindex="-1">
        <header class="top"><div><span class="eyebrow">Workspace / Administration</span><h1 id="page-title" tabindex="-1">Overview</h1><p id="page-description" class="muted"></p></div><div class="top-actions"><span id="last-refresh" class="muted freshness">Not yet refreshed</span><button id="refresh" type="button">Refresh</button></div></header>
        <p id="status" class="feedback global-status" role="status" aria-live="polite"></p>
        <section id="overview" class="page" aria-labelledby="page-title">
          <div id="summary" class="summary" aria-label="Server metrics"></div>
          <div class="overview-grid">
            <div class="card"><div class="heading"><div class="stack"><h2>Installed server</h2><p class="muted">Version information comes from the running MCP process.</p></div><span class="badge ready" id="server-status">Connected</span></div><dl class="facts" id="server-facts"></dl><div class="actions"><button data-go="connection" type="button" class="tonal">Connect a client</button><a href="https://modelcontextprotocol.io/specification" target="_blank" rel="noopener noreferrer">MCP specification ↗</a></div></div>
            <div class="card"><div class="stack"><h2>Provider readiness</h2><p class="muted">Configuration status, not an external health check.</p></div><dl class="facts" id="readiness"></dl><div class="actions"><button data-go="providers" type="button">Manage providers</button><button data-go="playground" type="button">Test a search</button></div></div>
          </div>
          <div class="card"><div class="heading"><div class="stack"><h2>Provider activity</h2><p class="muted">Cumulative attempts recorded while persistent server state is active. A cached search makes no new upstream attempt.</p></div></div>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Provider activity table"><table><thead><tr><th scope="col">Provider</th><th scope="col">Attempts</th><th scope="col">Success</th><th scope="col">Empty</th><th scope="col">Errors</th><th scope="col">Rate limits</th><th scope="col">Avg. latency</th></tr></thead><tbody id="metrics"></tbody></table></div>
            <p class="muted small">Rate limits are included in errors. Attempts are not billing units; providers may make several upstream HTTP requests per attempt.</p>
          </div>
        </section>
        <section id="providers" class="page" hidden aria-labelledby="page-title">
          <div class="card"><div class="heading"><div class="stack"><h2>Search engines</h2><p class="muted">Choose which engines the server may use. Saved changes apply to subsequent aggregated searches.</p></div><span id="provider-count" class="badge"></span></div>
            <div class="filters"><div class="field"><label for="provider-filter">Find a provider</label><input id="provider-filter" type="search" placeholder="Name or provider ID" /></div><fieldset class="filter-options"><legend>Show</legend><div class="choices">
              {["all","keyless","keyed","vertical","available"].map((v,i) => <label class="choice-chip"><input type="radio" name="provider-filter-kind" value={v} checked={i===0} />{["All","No key","Needs key / URL","Specialized","Available"][i]}</label>)}
            </div></fieldset></div>
            <p class="muted small">Available means enabled and configured. Search tests may still fail because of upstream limits. API credentials can incur charges; check provider terms.</p>
          </div>
          <div id="provider-list" class="provider-list card"></div><p id="provider-empty" class="muted" hidden>No matching providers. <button id="reset-filter" type="button">Clear filters</button></p>
        </section>
        <section id="playground" class="page" hidden aria-labelledby="page-title">
          <form id="search-form" class="card">
            <div class="stack"><h2>Search the web</h2><p class="muted">Run the same general search engine selection used by MCP clients. Cached results may be reused. Search terms are sent to the chosen providers.</p></div>
            <div class="field"><label for="query">Search query</label><textarea id="query" required maxlength="4000" aria-describedby="query-count" rows="3" placeholder="e.g. Python asyncio TaskGroup documentation"></textarea><span id="query-count" class="muted small">0 / 4000</span></div>
            <p id="search-default-summary" class="muted small" role="status">Loading server defaults…</p>
            <details id="search-overrides" class="search-options"><summary>Search options <span class="muted small">Optional overrides</span></summary>
              <fieldset><legend>Search mode</legend><div class="mode-grid">
                <label class="mode-option"><input type="radio" name="search-mode" value="default" checked /><span><strong>Server defaults</strong><small>Use the configuration shared by all MCP clients.</small></span></label>
                <label class="mode-option"><input type="radio" name="search-mode" value="auto" /><span><strong>Automatic</strong><small>Try available engines until results are found.</small></span></label>
                <label class="mode-option"><input type="radio" name="search-mode" value="keyless" /><span><strong>Keyless only</strong><small>Automatic fallback without API keys.</small></span></label>
                <label class="mode-option"><input type="radio" name="search-mode" value="selected" /><span><strong>Selected engines</strong><small>Search one or several in parallel.</small></span></label>
                <label class="mode-option"><input type="radio" name="search-mode" value="all" /><span><strong>All engines</strong><small>Search every available general engine in parallel.</small></span></label>
              </div></fieldset>
              <fieldset id="search-provider-field" hidden><legend>Choose engines</legend><div class="actions"><button id="select-keyless" type="button">Select keyless</button><button id="clear-selection" type="button">Clear selection</button><span id="selection-count" class="muted small"></span></div><div id="choices" class="choices"></div></fieldset>
              <div class="fields-grid">
                <div class="field"><label for="max-results">Maximum results</label><input id="max-results" type="number" min="1" max="30" aria-describedby="max-results-hint" /><span id="max-results-hint" class="muted small">Leave blank to inherit.</span></div>
                <div class="field"><label for="search-safe-search">SafeSearch</label><select id="search-safe-search"></select></div>
                <div class="field"><label for="search-recency">Freshness</label><select id="search-recency"></select></div>
              </div>
              <div class="stack"><label class="switch-label"><input id="search-answers" type="checkbox" class="switch" role="switch" aria-describedby="search-answers-hint" />Include provider AI answers</label><p id="search-answers-hint" class="muted small">Enable AI-enhanced search in Settings to use this option.</p></div>
              <div class="actions"><button type="button" class="tonal" data-go="settings">Manage server defaults</button><button type="button" id="reset-search-options">Use server defaults</button></div>
            </details>
            <div id="search-cost" class="notice" hidden>One or more possible engines require an API key or private instance. Requests may consume credits.</div>
            <div class="form-footer"><span class="muted small">Only the query is required.</span><button id="run-search" type="submit" class="primary">Run search</button></div>
            <p id="search-error" class="feedback" role="alert"></p>
          </form>
          <details class="card native-panel" id="native-panel">
            <summary>AI answers &amp; research <span class="badge">Optional · API credits</span></summary>
            <form id="native-form" class="stack">
              <p class="muted">Ask a provider's own AI to synthesize sources. Prism does not run a language model. Generated answers may be inaccurate; verify the sources. No automatic fallback or retries.</p>
              <div class="field"><label for="native-query">Question</label><textarea id="native-query" rows="3" maxlength="4000" required placeholder="What would you like to understand?"></textarea></div>
              <fieldset><legend>Capability</legend><div class="choices"><label class="choice-chip"><input type="radio" name="native-mode" value="answer" checked />Answer</label><label class="choice-chip"><input type="radio" name="native-mode" value="research" />Multi-step research</label></div></fieldset>
              <div class="field"><label for="native-provider">Provider</label><select id="native-provider"></select><p id="native-pricing" class="muted small"></p><div id="native-links" class="actions"></div></div>
              <div id="native-effort-field" class="field" hidden><label for="native-effort">Research depth</label><select id="native-effort"></select><p class="muted small">Depth and pricing depend on the provider. Prices are in USD and may change.</p></div>
              <p class="notice">This operation sends your question to the selected provider and may spend API credits. The normal search mode is unchanged.</p>
              <div class="actions"><button id="native-run" type="submit" class="primary">Generate answer</button><button type="button" data-go="providers">Manage API keys</button></div>
              <p id="native-feedback" class="feedback" role="status"></p>
            </form>
            <div id="native-result" class="stack" hidden><h2 id="native-heading">Generated answer</h2><p id="native-answer" class="native-answer"></p><p id="native-note" class="muted small"></p><h3>Sources supplied by provider</h3><ol id="native-sources" class="steps"></ol></div>
          </details>
          <div id="search-output" class="page" hidden><div class="card"><div class="heading"><h2>Search outcome</h2><span id="search-source" class="badge"></span></div><p id="search-summary" role="status" aria-live="polite"></p><ul id="search-attempts" class="attempt-list"></ul></div><div id="search-ai-results" class="stack" hidden><h2>Provider-generated answers</h2><p class="muted">Generated by the selected engines, not independently verified by Prism. Check the original sources.</p><ul id="search-ai-attempts" class="attempt-list"></ul><div id="search-ai-cards" class="result-list"></div></div><div id="results" class="result-list"></div></div>
        </section>
        <section id="cache" class="page" hidden aria-labelledby="page-title">
          <div class="summary cache-summary" id="cache-summary"></div>
          <div class="card"><div class="stack"><h2>Cache storage</h2><p class="muted">Search and webpage-fetch caches reduce repeated upstream work. Files may contain query text or fetched content.</p></div><div class="table-wrap" tabindex="0" role="region" aria-label="Cache namespaces"><table><thead><tr><th scope="col">Namespace</th><th scope="col">Entries</th><th scope="col">Disk usage</th><th scope="col">Action</th></tr></thead><tbody id="cache-rows"></tbody></table></div><p class="muted small">Storage directory: <code id="cache-dir"></code></p><div class="actions"><button id="prune" type="button">Prune expired entries</button><button id="clear-cache" class="danger" type="button">Clear all cache</button></div><p id="cache-feedback" class="feedback" role="status"></p></div>
          <div class="card"><h2>Cache policy</h2><p class="muted">Pruning removes expired or invalid entries without deleting valid cached results. Clearing removes saved results and may temporarily increase upstream requests; it does not remove provider keys or settings.</p><div class="actions"><button type="button" data-go="settings">Adjust cache TTLs</button></div></div>
        </section>
        <section id="logs" class="page" hidden aria-labelledby="page-title">
          <div class="card">
            <div class="heading"><div class="stack"><h2>Operational logs</h2><p class="muted">Sanitized events from the running server. No queries, API keys, URLs or answer content.</p></div><span id="logs-health" class="badge">Not loaded</span></div>
            <div class="fields-grid">
              <div class="field"><label for="logs-level">Severity</label><select id="logs-level"><option value="">All levels</option><option>DEBUG</option><option>INFO</option><option>WARNING</option><option>ERROR</option><option>CRITICAL</option></select></div>
              <div class="field"><label for="logs-provider">Provider</label><select id="logs-provider"><option value="">All providers</option></select></div>
              <div class="field"><label for="logs-period">Period</label><select id="logs-period"><option value="all">All retained events</option><option value="hour">Last hour</option><option value="day">Last 24 hours</option><option value="week">Last 7 days</option></select></div>
              <div class="field"><label for="logs-search">Search events</label><input id="logs-search" type="search" maxlength="100" placeholder="Request ID, event or outcome" /></div>
            </div>
            <div class="actions"><label class="switch-label"><input id="logs-live" type="checkbox" class="switch" role="switch" checked /> Live updates (5 seconds)</label><button type="button" id="logs-refresh">Refresh logs</button><button type="button" id="logs-export" disabled>Export JSON</button></div>
            <p id="logs-feedback" class="feedback" role="status"></p>
            <p class="muted small">Up to 200 matching events, newest first. Local retention: three files of 10 MiB each. Filters and exports contain only sanitized event metadata.</p>
            <div id="logs-list" class="log-list" aria-label="Operational events"></div>
          </div>
        </section>
        <section id="settings" class="page" hidden aria-labelledby="page-title">
          <div class="card appearance-card"><div class="stack"><h2>Appearance</h2><p class="muted">Preferences apply only to this browser.</p></div><div class="appearance-options"><button id="settings-theme" type="button">Switch to White</button><label class="switch-label"><input id="starfield-toggle" class="switch" type="checkbox" role="switch" aria-describedby="starfield-hint" />Starfield Depth</label></div><p id="starfield-hint" class="muted">Optional animated background.</p></div>
          <form id="defaults-form" class="card">
            <div class="stack"><h2>Server defaults</h2><p class="muted">Configure once. MCP clients and the Playground inherit these values unless a request explicitly overrides them. Environment-managed values are locked. These are preferences, not security policies.</p></div>
            <div id="default-fields" class="stack"></div>
            <div class="actions"><button id="save-defaults" type="submit" class="primary">Save defaults</button><button id="reset-defaults" type="button">Reset unsaved changes</button><button id="builtin-defaults" type="button">Use built-in values</button></div>
            <p id="defaults-feedback" class="feedback" role="status"></p>
          </form>
          <form id="ai-settings-form" class="card"><div class="stack"><h2>AI-enhanced search</h2><p class="muted">Allow normal web searches to include native AI responses from explicitly authorized engines. Disabled by default. Automatic fallback prioritizes authorized engines when synthesis is eligible. Enabling this setting authorizes credit consumption for the selected providers across MCP clients and the Playground, without a separate confirmation on every search.</p></div>
            <label class="switch-label"><input id="ai-search-enabled" type="checkbox" role="switch" class="switch" aria-describedby="ai-policy-lock" />Enable AI-enhanced search</label>
            <p id="ai-policy-lock" class="muted small"></p>
            <fieldset id="ai-provider-field"><legend>Authorized providers</legend><p class="muted small">Choose engines individually. Only enabled and configured providers can be used. Tavily, Exa and You.com return search and answers in a single call; Brave and Jina use additional generation calls.</p><div id="ai-provider-list" class="stack"></div></fieldset>
            <p class="notice">Generated answers can be inaccurate. Searches that run synthesis bypass the regular cache, may be slower and can incur extra costs. Domain controls, freshness, SafeSearch and queries over 400 characters disable synthesis. Automatic fallback only enhances engines it actually uses. A failed synthesis does not discard valid search results.</p>
            <div class="actions"><button id="save-ai-settings" class="primary" type="submit">Save AI search settings</button><button id="reset-ai-settings" type="button">Reset unsaved changes</button></div>
            <p id="ai-settings-feedback" class="feedback" role="status"></p>
          </form>
          <form id="settings-form" class="card"><div class="stack"><h2>Operational settings</h2><p class="muted">Timeout and cache settings apply to subsequent searches. Values supplied by environment variables are locked and take priority.</p></div>
            <div class="field"><label for="timeout">Provider timeout (seconds)</label><p id="timeout-help" class="muted small">Time budget for each provider, between 2 and 120 seconds. Automatic fallback can take longer overall.</p><input id="timeout" type="number" min="2" max="120" required aria-describedby="timeout-help timeout-lock" /><span id="timeout-lock" class="muted small"></span></div>
            <div class="fields-grid"><div class="field"><label for="search_ttl">Search cache TTL (seconds)</label><p id="search-ttl-help" class="muted small">How long to reuse search results. Freshness-sensitive searches may use a shorter TTL.</p><input id="search_ttl" type="number" min="60" max="604800" required aria-describedby="search-ttl-help search_ttl-lock" /><span id="search_ttl-lock" class="muted small"></span></div>
            <div class="field"><label for="fetch_ttl">Fetch cache TTL (seconds)</label><p id="fetch-ttl-help" class="muted small">How long to reuse extracted webpage content.</p><input id="fetch_ttl" type="number" min="60" max="604800" required aria-describedby="fetch-ttl-help fetch_ttl-lock" /><span id="fetch_ttl-lock" class="muted small"></span></div></div>
            <fieldset id="preferred-field"><legend>Preferred engine</legend><p class="muted small">Preference breaks ties between engines with equal observed health. Disabled or unconfigured engines are skipped.</p><details id="preferred-picker"><summary id="preferred-label">Default order</summary><div id="preferred" class="radio-list" role="radiogroup" aria-label="Preferred engine"></div></details><span id="preferred-lock" class="muted small"></span></fieldset>
            <div class="actions"><button class="primary" type="submit">Save settings</button><button type="button" id="reset-settings">Reset unsaved changes</button></div><p id="settings-feedback" class="feedback" role="status"></p>
          </form>
        </section>
        <section id="connection" class="page" hidden aria-labelledby="page-title">
          <div class="card"><div class="stack"><h2>Connect your MCP client</h2><p class="muted">Use the MCP service URL, not this dashboard URL. The MCP bearer token is separate from your administrator password.</p></div>
            <div class="field"><label for="endpoint">MCP endpoint</label><input id="endpoint" type="url" required placeholder="https://search.example.com/mcp" aria-describedby="endpoint-help connection-feedback" /><p class="muted small" id="endpoint-help">Enter the address and port accessible from your client. For the default local Compose deployment: http://127.0.0.1:49317/mcp. For remote access, use a trusted HTTPS reverse proxy.</p></div>
            <fieldset><legend>Client configuration</legend><div class="choices"><label class="choice-chip"><input name="client-type" type="radio" value="opencode" checked />OpenCode</label><label class="choice-chip"><input name="client-type" type="radio" value="generic" />HTTP details</label></div></fieldset>
            <div class="code-panel"><div class="code-header"><span id="config-label" class="eyebrow">OpenCode JSON</span><button id="copy-config" type="button">Copy configuration</button></div><pre id="connection-json" tabindex="0"></pre></div>
            <p class="muted small">Replace the token placeholder privately and merge the example into your existing client configuration. No real token is retrieved by this dashboard.</p><p id="connection-feedback" class="feedback" role="status"></p>
            <div class="actions"><a href="https://opencode.ai/docs/mcp-servers/" target="_blank" rel="noopener noreferrer">OpenCode guide ↗</a><a href="https://modelcontextprotocol.io/specification" target="_blank" rel="noopener noreferrer">MCP specification ↗</a><a href="https://github.com/isyuricunha/mcp-prism-search" target="_blank" rel="noopener noreferrer">Installation guide ↗</a></div>
          </div>
          <div class="card"><h2>Verify the connection</h2><ol class="steps"><li>Configure the MCP endpoint and bearer authorization in your client.</li><li>Connect and list the available tools. Look for <code>web_search</code>.</li><li>Run a small keyless search, for example with <code>keenable</code>, and check the result URLs.</li></ol><dl class="facts" id="connection-facts"></dl></div>
        </section>
        <footer class="main-footer"><span>Prism Search · Self-hosted administration</span><a href="https://github.com/isyuricunha/mcp-prism-search/issues" target="_blank" rel="noopener noreferrer">Report an issue ↗</a></footer>
      </main>
    </div>
    <dialog id="confirmation" aria-labelledby="confirm-title" aria-describedby="confirm-description">
      <form method="dialog" class="confirm-form"><h2 id="confirm-title"></h2><p class="muted" id="confirm-description"></p><div class="dialog-actions"><button value="cancel" autofocus>Cancel</button><button id="confirm-action" value="confirm" class="danger">Confirm</button></div></form>
    </dialog>
    <noscript><style>#boot{display:none}</style><p class="card">JavaScript is required for this local administration interface.</p></noscript>
    <script>import "../effects/appearance";</script>
  </body>
</html>
